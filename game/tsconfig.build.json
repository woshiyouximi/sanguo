{
  // 浏览器预览用构建配置：只编译"能在浏览器跑"的那部分（core + view + types）。
  // data.ts 依赖 node:fs，故意排除；浏览器/Cocos 各自加载 JSON 再组 GameData。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    // core 是"已冻结、15 项测试通过"的纯逻辑：它自身有 4 处类型标注小瑕疵
    //（winner 允许 'draw'、Magic 未 import 等），按约定不能改 core。
    // 用 noCheck 只做语法转译、不做类型检查，构建才能干净退出；类型问题由
    // `tsc --noEmit`（tsconfig.json）与 15 项测试各自把关。
    "noCheck": true,
    "declaration": false,
    "sourceMap": false,
    "noEmit": false
  },
  "include": ["src/core/**/*.ts", "src/view/**/*.ts", "src/types.ts"]
}
